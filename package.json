{
  "name": "monday-quest",
  "type": "module",
  "version": "1.0.4",
  "private": true,
  "description": "Monday Quest — 30 weekly challenges to become a more resilient version of yourself.",
  "author": "Martin Donadieu <martin@capgo.app>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "sounds": "bun scripts/gen-sounds.ts",
    "cap:sync": "bun run build && cap sync",
    "ios": "bun run cap:sync && cap open ios",
    "android": "bun run cap:sync && cap open android",
    "native:setup": "bash scripts/native-setup.sh",
    "assets": "bunx @capacitor/assets generate --iconBackgroundColor '#141414' --splashBackgroundColor '#f6f4ef'"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/app": "^8",
    "@capacitor/core": "^8",
    "@capacitor/haptics": "^8",
    "@capacitor/ios": "^8",
    "@capacitor/keyboard": "^8",
    "@capacitor/network": "^8",
    "@capacitor/preferences": "^8",
    "@capacitor/splash-screen": "^8",
    "@capacitor/status-bar": "^8",
    "@capgo/camera-preview": "^8.11.10",
    "@capgo/capacitor-accelerometer": "^8.0.46",
    "@capgo/capacitor-alarm": "^8.1.11",
    "@capgo/capacitor-barometer": "^8.0.20",
    "@capgo/capacitor-brightness": "^8.0.21",
    "@capgo/capacitor-compass": "^8.1.21",
    "@capgo/capacitor-date-picker": "^8.1.10",
    "@capgo/capacitor-file-sharer": "^8.1.13",
    "@capgo/capacitor-health": "^8.11.7",
    "@capgo/capacitor-home-indicator": "^8.1.0",
    "@capgo/capacitor-in-app-review": "^8.2.5",
    "@capgo/capacitor-inappbrowser": "^8.22.1",
    "@capgo/capacitor-keep-awake": "^8.1.17",
    "@capgo/capacitor-light-sensor": "^8.1.19",
    "@capgo/capacitor-native-audio": "^8.4.31",
    "@capgo/capacitor-native-navigation": "^8.6.0",
    "@capgo/capacitor-navigation-bar": "^8.2.12",
    "@capgo/capacitor-pedometer": "^8.0.46",
    "@capgo/capacitor-photo-library": "^8.0.28",
    "@capgo/capacitor-pretty-toast": "^8.1.20",
    "@capgo/capacitor-privacy-screen": "^8.3.11",
    "@capgo/capacitor-rich-notifications": "^8.2.5",
    "@capgo/capacitor-shake": "^8.0.47",
    "@capgo/capacitor-sheets": "^8.1.0",
    "@capgo/capacitor-speech-recognition": "^8.4.0",
    "@capgo/capacitor-speech-synthesis": "^8.0.23",
    "@capgo/capacitor-transitions": "^8.3.1",
    "@capgo/capacitor-updater": "^8.52.1",
    "@capgo/capacitor-volume-buttons": "^8.1.3",
    "@capgo/capacitor-widget-kit": "^8.1.12",
    "@capgo/native-purchases": "^8.9.2",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/didact-gothic": "^5.3.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@capacitor/cli": "^8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
