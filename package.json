{
  "name": "monday-quest",
  "type": "module",
  "version": "1.1.21",
  "private": true,
  "description": "Monday Quest — 30 weekly challenges to become a more resilient version of yourself.",
  "author": "Martin Donadieu <martin@capgo.app>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite --host",
    "build": "bun scripts/extract-strings.ts && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "sounds": "bun scripts/gen-sounds.ts",
    "cap:sync": "bun run build && cap sync",
    "ios": "bun run cap:sync && cap open ios",
    "android": "bun run cap:sync && cap open android",
    "native:setup": "bash scripts/native-setup.sh",
    "assets": "bunx @capacitor/assets generate --iconBackgroundColor '#141414' --splashBackgroundColor '#f6f4ef'",
    "ota": "bun run build && bunx @capgo/cli@latest bundle upload ee.forgr.mondayquest --path dist --channel production --delta --ignore-metadata-check --version-exists-ok"
  },
  "dependencies": {
    "@capacitor/android": "^8",
    "@capacitor/app": "^8",
    "@capacitor/core": "^8",
    "@capacitor/geolocation": "^8",
    "@capacitor/haptics": "^8",
    "@capacitor/ios": "^8",
    "@capacitor/keyboard": "^8",
    "@capacitor/network": "^8",
    "@capacitor/preferences": "^8",
    "@capacitor/splash-screen": "^8",
    "@capacitor/status-bar": "^8",
    "@capgo/camera-preview": "^8.14.2",
    "@capgo/capacitor-accelerometer": "^8.0.52",
    "@capgo/capacitor-alarm": "^8.1.14",
    "@capgo/capacitor-barometer": "^8.0.23",
    "@capgo/capacitor-brightness": "^8.0.24",
    "@capgo/capacitor-compass": "^8.1.24",
    "@capgo/capacitor-date-picker": "^8.1.14",
    "@capgo/capacitor-file-sharer": "^8.1.16",
    "@capgo/capacitor-health": "^8.11.12",
    "@capgo/capacitor-home-indicator": "^8.1.4",
    "@capgo/capacitor-icloud-kv": "^8.1.2",
    "@capgo/capacitor-in-app-review": "^8.2.9",
    "@capgo/capacitor-inappbrowser": "^8.26.1",
    "@capgo/capacitor-keep-awake": "^8.1.20",
    "@capgo/capacitor-light-sensor": "^8.1.23",
    "@capgo/capacitor-native-audio": "^8.4.38",
    "@capgo/capacitor-native-navigation": "^8.13.2",
    "@capgo/capacitor-navigation-bar": "^8.2.17",
    "@capgo/capacitor-pedometer": "^8.0.51",
    "@capgo/capacitor-photo-library": "^8.0.32",
    "@capgo/capacitor-pretty-toast": "^8.1.27",
    "@capgo/capacitor-rich-notifications": "^8.2.7",
    "@capgo/capacitor-shake": "^8.0.52",
    "@capgo/capacitor-sheets": "^8.2.4",
    "@capgo/capacitor-speech-recognition": "^8.4.4",
    "@capgo/capacitor-speech-synthesis": "^8.0.27",
    "@capgo/capacitor-transitions": "^8.3.6",
    "@capgo/capacitor-updater": "^8.53.1",
    "@capgo/capacitor-volume-buttons": "^8.1.6",
    "@capgo/capacitor-widget-kit": "^8.1.15",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/didact-gothic": "^5.3.0",
    "jspdf": "^4.2.1",
    "pinia": "^4.0.3",
    "suncalc": "^2.1.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@capacitor/cli": "^8",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/suncalc": "^1.9.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
